<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1;net481</TargetFrameworks>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ProceduralGraph</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ThrowHelpers.cs" LinkBase="Shared" />
    <Compile Include="..\Shared\RentedArray.cs" LinkBase="Shared" /> 
    <Compile Include="..\Shared\SpanExtensions.cs" LinkBase="Shared" /> 
    <Compile Include="..\Shared\TaskExtensions.cs" LinkBase="Shared" /> 
    <Compile Include="..\Shared\IntegerLookup.cs" LinkBase="Shared" /> 
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Include="..\Polyfills\ConcurrentDictionaryExtensions.cs" LinkBase="Polyfills" />
    <Compile Include="..\Polyfills\TaskExtensions.cs" LinkBase="Polyfills" />
    <PackageReference Include="System.Threading.Channels" Version="10.*" />
    <PackageReference Include="System.Collections.Immutable" Version="10.*" />
    <PackageReference Include="PolySharp" Version="1.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.*" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.*" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.*" />
    <PackageReference Include="System.Memory" Version="4.6.*" />
  </ItemGroup>

</Project>
