<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1;net481</TargetFrameworks>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>GameSharp.Sandbox</RootNamespace>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="ThrowHelpers.cs"/>
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\GameSharp.Sandbox\GameSharp.Sandbox.csproj" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.*" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <Compile Remove="Generic\Unix\**\*" />
  </ItemGroup>

</Project>
